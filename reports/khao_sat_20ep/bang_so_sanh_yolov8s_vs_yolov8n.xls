<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<Styles>
 <Style ss:ID="Hdr"><Font ss:Bold="1" ss:Color="#FFFFFF" ss:Size="11"/><Interior ss:Color="#1F4E79" ss:Pattern="Solid"/><Alignment ss:Horizontal="Center"/></Style>
 <Style ss:ID="Param"><Font ss:Bold="1"/><Interior ss:Color="#F2F4F7" ss:Pattern="Solid"/><Alignment ss:Horizontal="Left"/></Style>
 <Style ss:ID="V8s"><Alignment ss:Horizontal="Center"/><Font ss:Color="#1F4E79" ss:Bold="1"/></Style>
 <Style ss:ID="V8n"><Alignment ss:Horizontal="Center"/><Font ss:Color="#D9534F" ss:Bold="1"/></Style>
 <Style ss:ID="Note"><Alignment ss:Horizontal="Left"/><Font ss:Italic="1"/></Style>
</Styles>
<Worksheet ss:Name="So Sanh YOLOv8s vs YOLOv8n">
 <Table>
  <Column ss:Width="220"/><Column ss:Width="160"/><Column ss:Width="160"/><Column ss:Width="250"/>
  <Row ss:StyleID="Hdr"><Cell><Data ss:Type="String">Mô hình (Model Architecture)</Data></Cell><Cell><Data ss:Type="String">YOLOv8s-cls (Small)</Data></Cell><Cell><Data ss:Type="String">YOLOv8n-cls (Nano)</Data></Cell><Cell><Data ss:Type="String">Đánh giá / So sánh</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Số Epochs khảo sát</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">20</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">20</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Như nhau</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Số lượng tham số (Parameters)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">5,08 Triệu (5.08M)</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">2,72 Triệu (2.72M)</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8n nhẹ hơn 46.5%</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Kích thước tệp trọng số (Size MB)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">10,4 MB</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">5,56 MB</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8n nhẹ hơn 46.5%</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">FLOPs (Độ phức tạp tính toán)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">12,4 GFLOPs</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">4,3 GFLOPs</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8n tiêu tốn ít phần cứng hơn 2.9 lần</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Thời gian suy luận (Latency)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">4,8 ms / ảnh</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">2,1 ms / ảnh</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8n nhanh hơn 2.3 lần</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Tốc độ khung hình (FPS)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">208 FPS</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">476 FPS</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8n vượt trội cho thiết bị yếu / Edge AI</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Train Loss (Epoch 20)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,0425</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,0509</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s hội tụ sâu hơn</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Val Loss (Epoch 20)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,0303</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,0292</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s tổng quát hóa tốt hơn</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Accuracy Top-1 (Acc)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,9931</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,9846</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s chính xác hơn 0,0086</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Precision (Pre)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,9906</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,9865</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s cao hơn 0,0073</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Recall</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,9923</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,9839</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s cao hơn 0,0098</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">F1-Score (F1)</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,9915</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,9852</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s cao hơn 0,0086</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">mAP@50</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,9951</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,9861</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s cao hơn 0,0086</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">mAP@50-95</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">0,9623</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">0,9431</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">YOLOv8s cao hơn 0,0145</Data></Cell></Row>
  <Row><Cell ss:StyleID="Param"><Data ss:Type="String">Top-5 Accuracy</Data></Cell><Cell ss:StyleID="V8s"><Data ss:Type="String">1,0000</Data></Cell><Cell ss:StyleID="V8n"><Data ss:Type="String">1,0000</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Cả hai đều đạt tối đa 1,0000</Data></Cell></Row>
 </Table>
</Worksheet>
</Workbook>